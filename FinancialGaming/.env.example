# Local dev — leave API/WS empty; Vite proxies /api and /ws to Spring Boot on :8080
VITE_API_URL=
VITE_WS_URL=

# Production (Vercel) — set these in the Vercel dashboard before deploying
# VITE_API_URL=https://your-backend.onrender.com
# VITE_WS_URL=https://your-backend.onrender.com/ws

# Optional display fallbacks — live timers come from the server game state
VITE_TURN_TIMEOUT_SECONDS=10
VITE_ROUND_INTRO_TIMEOUT_SECONDS=60
